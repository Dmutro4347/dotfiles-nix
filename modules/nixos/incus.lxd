  { config, pkgs, ... }:

{
  virtualisation.incus = {
    enable = true;
    # Створює групу incus-admin і додає сюди користувача
    # Доступ до incus без sudo
    users = [ "arfors" ]; # ← заміни на свій username
    preseed = "";
  };

  # Incus потребує networkd
  networking.useNetworkd = true;
  networking.useDHCP = false;

  # Щоб bridge працював
  networking.firewall.trustedInterfaces = [ "incusbr0" ];
}

